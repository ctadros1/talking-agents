{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "talking-agents",
  "account_id": "b7f0d3410d63702a06431f2bc750061f",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-11-09",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist/site",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none",
  },
  "routes": [
    { "pattern": "ctad.dev/talking-agents", "zone_name": "ctad.dev" },
    { "pattern": "ctad.dev/talking-agents/*", "zone_name": "ctad.dev" },
  ],
  "observability": { "enabled": true },
}
